{
	"name": "koa2-initbase",
	"version": "1.0.0",
	"description": "koa2-initbase",
	"main": "dist/app.js",
	"scripts": {
		"prettier:write": "prettier --write .",
		"prettier:check": "prettier --check .",
		"nodemon:dev": "nodemon",
		"copy:view": "cpx \"src/app/view/**/*\" dist/app/view",
		"copy:view:dev": "cpx \"src/app/view/**/*\" dist/app/view --watch",
		"build": "npm run clean && tsc -p tsconfig.json && npm run copy:view",
		"build:dev": "tsc -p tsconfig.json --watch",
		"start": "node dist/app.js",
		"start:dev": "nodemon --config nodemon.dist.json",
		"clean": "rimraf dist"
	},
	"keywords": [
		"koa",
		"koa2",
		"typescript"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@koa/cors": "^5.0.0",
		"koa": "^2.15.3",
		"koa-bodyparser": "^4.4.1",
		"koa-ejs": "^4.3.0",
		"koa-router": "^12.0.1"
	},
	"devDependencies": {
		"@types/koa": "^2.15.0",
		"@types/koa__cors": "^5.0.1",
		"@types/koa-bodyparser": "^4.3.12",
		"@types/koa-ejs": "^4.3.3",
		"@types/koa-router": "^7.4.8",
		"@types/node": "^22.9.0",
		"cpx2": "^8.0.2",
		"nodemon": "^3.1.7",
		"prettier": "^3.9.8",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.3"
	}
}
